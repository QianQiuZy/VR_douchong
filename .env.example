# 数据库配置
DB_HOST=localhost
DB_USER=111
DB_PASSWORD=111
DB_NAME=111
DB_PORT=3306
# QueuePool 容量（默认保持 SQLAlchemy 当前有效值）
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REPORT_MAX_CONCURRENCY=2
REPORT_ACQUIRE_TIMEOUT_SECONDS=0.1

# API 缓存始终使用 REDIS_URL 的 DB2，不影响 DB0 / DB1。
# 正式部署保持开启；关闭仅用于离线诊断，旧报表不受缓存 SQL 预算保护。
API_CACHE_ENABLED=1
API_CACHE_PREFIX=vr:api:v1
API_CACHE_REFRESH_SECONDS=10
API_CACHE_MAX_AGE_SECONDS=30
API_CACHE_HISTORY_SECONDS=300
API_CACHE_MAX_BYTES=100663296
API_CACHE_SQL_PER_SECOND=9
API_RATE_LIMIT_PER_IP=20
API_CACHE_MAX_INFLIGHT=32

# B站 Cookies
SESSDATA_VALUE=
BILI_JCT_VALUE=
DEDEUSERID_VALUE=
DEDEUSERID_CKMD5_VALUE=
SID_VALUE=
BUVID3_VALUE=
DEVICE_FP_VALUE=

# 邮件告警
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=4666
ROOMS_JSON_PATH=rooms.json
# 访客名单：相对路径以实际 ENV_FILE / .env 所在目录为基准，每小时重新读取。
ENTRY_USERS_JSON_PATH=entry_users.json
API_SECRET=

# Redis（付费人数去重与15分钟临时聚合）
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_TTL_SECONDS=7776000
