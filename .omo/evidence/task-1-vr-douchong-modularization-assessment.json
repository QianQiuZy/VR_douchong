  "route_status_and_shape_contracts": {
    "POST /add/room": {
      "401_missing_key": {
        "body": {
          "error": "缺少 API 密钥"
        }
      },
      "401_invalid_key": {
        "body": {
          "error": "API 密钥无效"
        }
      },
      "400_missing_room_id": {
        "body": {
          "error": "room_id 必填"
        }
      },
      "400_non_integer_room_id": {
        "body": {
          "error": "room_id 必须为整数"
        }
      },
      "400_negative_room_id": {
        "body": {
          "error": "room_id 必须为正整数"
        }
      },
      "400_missing_room_anchors": {
        "body": {
          "error": "room_anchors 必填"
        }
      },
      "400_empty_room_anchors": {
        "body": {
          "error": "room_anchors 必须为非空字符串"
        }
      },
      "200_success_keys": [
        "ok",
        "room_id",
        "message"
      ],
      "409_conflict_keys": [
        "ok",
        "room_id",
        "message"
      ],
      "500_internal_failure": {
        "body": {
          "error": "添加房间失败"
        }
      },
      "auth_methods_accepted": [
        "X-API-Key header",
        "Authorization: Bearer <secret>",
        "body.api_key"
      ]
    },
    "POST /delete/room": {
      "401_missing_key": {
        "body": {
          "error": "缺少 API 密钥"
        }
      },
      "401_invalid_key": {
        "body": {
          "error": "API 密钥无效"
        }
      },
      "400_missing_room_id": {
        "body": {
          "error": "room_id 必填"
        }
      },
      "200_success_keys": [
        "ok",
        "room_id",
        "message"
      ],
      "404_not_found_keys": [
        "ok",
        "room_id",
        "message"
      ]
    },
    "GET /gift": {
      "200_shape": "list[room_dict]",
